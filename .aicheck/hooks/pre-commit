#!/bin/bash

# AICheck pre-commit hook
# Enforces AICheck rules and requirements

# Check if we're in an AICheck-managed repository
if [ ! -f "RULES.md" ]; then
    echo "⚠️ Warning: RULES.md not found. This may not be an AICheck-managed repository."
    exit 0
fi

# Check if common functions are available
if [ ! -f ".aicheck/scripts/common.sh" ]; then
    echo "❌ Error: AICheck common functions not found"
    echo "Please run the AICheck installer again"
    exit 1
fi

# Source common functions
source .aicheck/scripts/common.sh
source .aicheck/scripts/action.sh

# Get the current ActiveAction
if [ ! -f ".aicheck/current_action" ]; then
    echo "⚠️ Warning: No ActiveAction set"
    current_action="None"
else
    current_action=$(cat .aicheck/current_action)
    # Validate ActiveAction exists
    if [ ! -d ".aicheck/actions/$current_action" ]; then
        echo "❌ Error: ActiveAction '$current_action' does not exist"
        echo "Please set a valid ActiveAction"
        exit 1
    fi
fi

# Get list of files being committed
files=$(git diff --cached --name-only)

# Function to check if changes are substantive
is_substantive_change() {
    local file=$1
    # Get the diff content
    local diff_content=$(git diff --cached -- "$file")
    
    # Check for changes to content (not just whitespace)
    if echo "$diff_content" | grep -q "^[+-][^+-]"; then
        return 0  # Substantive change found
    fi
    return 1  # No substantive change
}

# Check for changes to critical files
critical_files=(
    "RULES.md"
    ".aicheck/docs/actions_index.md"
    ".aicheck/current_action"
)

for file in "${critical_files[@]}"; do
    if echo "$files" | grep -q "^$file$"; then
        if is_substantive_change "$file"; then
            # Validate actions index if it's being modified
            if [ "$file" == ".aicheck/docs/actions_index.md" ]; then
                validate_actions_index
            fi
        else
            echo "ℹ️ Note: Non-substantive changes to $file (whitespace only)"
        fi
    fi
done

# Check for changes outside ActiveAction scope
if [ "$current_action" != "None" ]; then
    action_dir=".aicheck/actions/$current_action"
    action_plan="$action_dir/$current_action-PLAN.md"
    
    # Get files in scope from action plan
    if [ -f "$action_plan" ]; then
        # Extract files section and clean up the list
        in_scope_files=$(grep -A 100 "## Files in Scope" "$action_plan" | grep -v "##" | grep "^- " | sed 's/^- //' | sed 's/`//g')
    else
        in_scope_files=""
    fi
    
    for file in $files; do
        # Skip files that are part of the ActiveAction
        if [[ "$file" == "$action_dir"* ]]; then
            continue
        fi
        
        # Skip critical files (already checked above)
        if [[ "$file" == "RULES.md" ]] || [[ "$file" == ".aicheck/docs/actions_index.md" ]] || [[ "$file" == ".aicheck/current_action" ]]; then
            continue
        fi
        
        # Skip template files (already checked above)
        if [[ "$file" == ".aicheck/templates/"* ]]; then
            continue
        fi
        
        # Skip non-substantive changes
        if ! is_substantive_change "$file"; then
            echo "ℹ️ Note: Non-substantive changes to $file (whitespace only)"
            continue
        fi
        
        # Check if file is in scope
        in_scope=false
        while IFS= read -r scope_file; do
            if [ -n "$scope_file" ] && [ "$file" == "$scope_file" ]; then
                in_scope=true
                break
            fi
        done <<< "$in_scope_files"
        
        if [ "$in_scope" = true ]; then
            continue
        fi
        
        # Skip AdminAudit files
        if [[ "$file" == ".aicheck/actions/AdminAudit/"* ]]; then
            continue
        fi
        
        # Skip action plan files
        if [[ "$file" == ".aicheck/actions/"*"-PLAN.md" ]]; then
            continue
        fi
        
        echo "⚠️ WARNING: Substantive changes detected outside ActiveAction scope: $file"
        echo "Current ActiveAction: $current_action"
        echo "Please confirm this change is within the ActiveAction scope. (y/n)"
        read -r in_scope
        if [ "$in_scope" != "y" ]; then
            echo "❌ Commit rejected: Changes must be within ActiveAction scope"
            exit 1
        fi
    done
fi

# All checks passed
echo "✅ AICheck pre-commit checks passed"
exit 0 