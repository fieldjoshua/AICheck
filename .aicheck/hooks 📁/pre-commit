#!/bin/bash

# AICheck pre-commit hook
# Enforces AICheck rules and requirements

# Check if we're in an AICheck-managed repository
if [ ! -f "RULES.md" ]; then
    echo "⚠️ Warning: RULES.md not found. This may not be an AICheck-managed repository."
    exit 0
fi

# Check if common functions are available
if [ ! -f ".aicheck/scripts/common.sh" ]; then
    echo "❌ Error: AICheck common functions not found"
    echo "Please run the AICheck installer again"
    exit 1
fi

# Source common functions
source .aicheck/scripts/common.sh
source .aicheck/scripts/action.sh

# Get the current ActiveAction
if [ ! -f ".aicheck/current_action" ]; then
    echo "⚠️ Warning: No ActiveAction set"
    current_action="None"
else
    current_action=$(cat .aicheck/current_action)
    # Validate ActiveAction exists
    if [ ! -d ".aicheck/actions/$current_action" ]; then
        echo "❌ Error: ActiveAction '$current_action' does not exist"
        echo "Please set a valid ActiveAction"
        exit 1
    fi
fi

# Get list of files being committed
files=$(git diff --cached --name-only)

# Color definitions
if [ -t 1 ]; then  # Check if stdout is a terminal
    PURPLE='\033[0;35m'
    ORANGE='\033[0;33m'
    RESET='\033[0m'
else
    # If not a terminal, disable colors
    PURPLE=''
    ORANGE=''
    RESET=''
fi

# Function to set directory colors and icons
set_directory_display() {
    # Set purple color for AICheck directories
    echo -e "\033[0;35m"
    
    # Add icons to AICheck directories
    for dir in .aicheck/*/; do
        if [ -d "$dir" ]; then
            # Add folder icon (📁) to directory name
            mv "$dir" "${dir%/} 📁"
        fi
    done
    
    # Reset color
    echo -e "\033[0m"
}

# Call the function before any checks
set_directory_display

# Function to check if changes are substantive
is_substantive_change() {
    local file=$1
    # Get the diff content
    local diff_content=$(git diff --cached -- "$file")
    
    # Check for changes to content (not just whitespace)
    if echo "$diff_content" | grep -q "^[+-][^+-]"; then
        return 0  # Substantive change found
    fi
    return 1  # No substantive change
}

# Function to check if a file is new
is_new_file() {
    local file=$1
    # Check if file exists in HEAD
    if git rev-parse --verify HEAD >/dev/null 2>&1; then
        if ! git ls-tree HEAD "$file" >/dev/null 2>&1; then
            return 0  # File is new
        fi
    else
        # First commit
        if [ ! -f "$file" ]; then
            return 0  # File is new
        fi
    fi
    return 1  # File exists
}

# Function to show rejection guidance
show_rejection_guidance() {
    local action_type=$1
    local action_name=$2
    
    echo -e "\n❌ APPROVAL REJECTED"
    echo "Please explain why this action was rejected."
    echo "The action will remain in its current state."
    echo ""
    echo "To proceed, you can:"
    echo "1. Review the changes and try again"
    echo "2. Modify the changes to address any concerns"
    echo "3. Contact the human manager for clarification"
    echo "4. Document the rejection reason in the action's notes"
    echo ""
    echo "Current state:"
    echo "- Action Type: $action_type"
    echo "- Action Name: $action_name"
    echo "- Status: Rejected"
    echo ""
    echo "Would you like to:"
    echo "a) Try again with the same changes"
    echo "b) Modify the changes"
    echo "c) Cancel the commit"
    read -r choice
    
    case "$choice" in
        a)
            echo "Retrying with same changes..."
            return 1
            ;;
        b)
            echo "Please modify your changes and try again."
            exit 1
            ;;
        c)
            echo "Commit cancelled."
            exit 1
            ;;
        *)
            echo "Invalid choice. Commit cancelled."
            exit 1
            ;;
    esac
}

# Function to check template changes
check_template_changes() {
    local has_template_changes=false
    template_files=()
    template_status=()
    
    for file in $files; do
        if [[ "$file" == ".aicheck/templates/"* ]]; then
            if is_substantive_change "$file"; then
                has_template_changes=true
                template_files+=("$file")
                if is_new_file "$file"; then
                    template_status+=("new")
                    echo -e "${PURPLE}📝 Detected new template: $file${RESET}"
                else
                    template_status+=("modified")
                    echo -e "${PURPLE}📝 Detected template modification: $file${RESET}"
                fi
            else
                echo -e "${PURPLE}ℹ️ Note: Non-substantive changes to template $file (whitespace only)${RESET}"
            fi
        fi
    done
    
    return $has_template_changes
}

# Function to check action plan changes
check_action_plan_changes() {
    local has_action_plan_changes=false
    action_plan_files=()
    action_plan_status=()
    
    for file in $files; do
        if [[ "$file" == ".aicheck/actions/"*"-PLAN.md" ]]; then
            if is_substantive_change "$file"; then
                has_action_plan_changes=true
                action_plan_files+=("$file")
                if is_new_file "$file"; then
                    action_plan_status+=("new")
                    echo -e "${ORANGE}📝 Detected new action plan: $file${RESET}"
                else
                    action_plan_status+=("modified")
                    echo -e "${ORANGE}📝 Detected action plan modification: $file${RESET}"
                fi
            else
                echo -e "${ORANGE}ℹ️ Note: Non-substantive changes to action plan $file (whitespace only)${RESET}"
            fi
        fi
    done
    
    return $has_action_plan_changes
}

# Function to check critical file changes
check_critical_file_changes() {
    local has_critical_changes=false
    critical_changed_files=()
    critical_status=()
    local critical_files=(
        "RULES.md"
        ".aicheck/docs/actions_index.md"
        ".aicheck/current_action"
    )
    
    for file in "${critical_files[@]}"; do
        if echo "$files" | grep -q "^$file$"; then
            if is_substantive_change "$file"; then
                has_critical_changes=true
                critical_changed_files+=("$file")
                if is_new_file "$file"; then
                    critical_status+=("new")
                    echo -e "${PURPLE}📝 Detected new critical file: $file${RESET}"
                else
                    critical_status+=("modified")
                    echo -e "${PURPLE}📝 Detected critical file modification: $file${RESET}"
                fi
            else
                echo -e "${PURPLE}ℹ️ Note: Non-substantive changes to $file (whitespace only)${RESET}"
            fi
        fi
    done
    
    return $has_critical_changes
}

# Function to check scope changes
check_scope_changes() {
    if [ "$current_action" == "None" ]; then
        return 0
    fi
    
    local action_dir=".aicheck/actions/$current_action"
    local action_plan="$action_dir/$current_action-PLAN.md"
    
    # Get files in scope from action plan
    if [ -f "$action_plan" ]; then
        # Extract files section and clean up the list
        in_scope_files=$(grep -A 100 "## Files in Scope" "$action_plan" | grep -v "##" | grep "^- " | sed 's/^- //' | sed 's/`//g')
    else
        in_scope_files=""
    fi
    
    for file in $files; do
        # Skip files that are part of the ActiveAction
        if [[ "$file" == "$action_dir"* ]]; then
            continue
        fi
        
        # Skip critical files (already checked)
        if [[ "$file" == "RULES.md" ]] || [[ "$file" == ".aicheck/docs/actions_index.md" ]] || [[ "$file" == ".aicheck/current_action" ]]; then
            continue
        fi
        
        # Skip template files (already checked)
        if [[ "$file" == ".aicheck/templates/"* ]]; then
            continue
        fi
        
        # Skip action plan files (already checked)
        if [[ "$file" == ".aicheck/actions/"*"-PLAN.md" ]]; then
            continue
        fi
        
        # Skip non-substantive changes
        if ! is_substantive_change "$file"; then
            echo "ℹ️ Note: Non-substantive changes to $file (whitespace only)"
            continue
        fi
        
        # Check if file is in scope
        in_scope=false
        while IFS= read -r scope_file; do
            if [ -n "$scope_file" ] && [ "$file" == "$scope_file" ]; then
                in_scope=true
                break
            fi
        done <<< "$in_scope_files"
        
        if [ "$in_scope" = true ]; then
            continue
        fi
        
        # Skip AdminAudit files
        if [[ "$file" == ".aicheck/actions/AdminAudit/"* ]]; then
            continue
        fi
        
        echo "⚠️ WARNING: Substantive changes detected outside ActiveAction scope: $file"
        echo "Current ActiveAction: $current_action"
        echo "Please confirm this change is within the ActiveAction scope. (y/n)"
        read -r in_scope
        if [ "$in_scope" != "y" ]; then
            echo "❌ Commit rejected: Changes must be within ActiveAction scope"
            echo ""
            echo "To proceed, you can:"
            echo "1. Add the file to the action's scope in the plan"
            echo "2. Switch to a different action that includes this file"
            echo "3. Create a new action for these changes"
            echo "4. Cancel the commit"
            read -r choice
            
            case "$choice" in
                1)
                    echo "Please update the action plan to include this file in scope"
                    exit 1
                    ;;
                2)
                    echo "Please switch to an appropriate action first"
                    exit 1
                    ;;
                3)
                    echo "Please create a new action for these changes"
                    exit 1
                    ;;
                4)
                    echo "Commit cancelled."
                    exit 1
                    ;;
                *)
                    echo "Invalid choice. Commit cancelled."
                    exit 1
                    ;;
            esac
        fi
    done
}

# Check changes in order of priority
has_template_changes=false
has_action_plan_changes=false
has_critical_changes=false

check_template_changes
template_status=$?
if [ $template_status -eq 1 ]; then
    has_template_changes=true
fi

check_action_plan_changes
action_plan_status=$?
if [ $action_plan_status -eq 1 ]; then
    has_action_plan_changes=true
fi

check_critical_file_changes
critical_status=$?
if [ $critical_status -eq 1 ]; then
    has_critical_changes=true
fi

# If we have multiple types of changes, get a single approval for all
if [ "$has_template_changes" = true ] || [ "$has_action_plan_changes" = true ] || [ "$has_critical_changes" = true ]; then
    # Debug information
    if [ "${AICHECK_DEBUG:-false}" = "true" ]; then
        echo "Debug: Template changes: ${#template_files[@]}"
        echo "Debug: Action plan changes: ${#action_plan_files[@]}"
        echo "Debug: Critical changes: ${#critical_changed_files[@]}"
    fi
    
    echo -e "${PURPLE}📋 AICheck Change Summary${RESET}"
    echo -e "${PURPLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    
    changes_list=""
    details=""
    
    if [ "$has_template_changes" = true ]; then
        template_count=${#template_files[@]}
        changes_list="$template_count template(s)"
        details="${details}${PURPLE}📄 Templates ($template_count files):\n${RESET}"
        for i in "${!template_files[@]}"; do
            status_emoji="📝"
            if [ "${template_status[$i]}" = "new" ]; then
                status_emoji="✨"
            fi
            details="${details}${PURPLE}  $status_emoji ${template_files[$i]} (${template_status[$i]})\n${RESET}"
        done
        details="${details}\n"
    fi
    
    if [ "$has_action_plan_changes" = true ]; then
        action_plan_count=${#action_plan_files[@]}
        if [ -n "$changes_list" ]; then
            changes_list="$changes_list, $action_plan_count action plan(s)"
        else
            changes_list="$action_plan_count action plan(s)"
        fi
        details="${details}${ORANGE}📋 Action Plans ($action_plan_count files):\n${RESET}"
        for i in "${!action_plan_files[@]}"; do
            status_emoji="📝"
            if [ "${action_plan_status[$i]}" = "new" ]; then
                status_emoji="✨"
            fi
            details="${details}${ORANGE}  $status_emoji ${action_plan_files[$i]} (${action_plan_status[$i]})\n${RESET}"
        done
        details="${details}\n"
    fi
    
    if [ "$has_critical_changes" = true ]; then
        critical_count=${#critical_changed_files[@]}
        if [ -n "$changes_list" ]; then
            changes_list="$changes_list, $critical_count critical file(s)"
        else
            changes_list="$critical_count critical file(s)"
        fi
        details="${details}${PURPLE}⚠️  Critical Files ($critical_count files):\n${RESET}"
        for i in "${!critical_changed_files[@]}"; do
            status_emoji="📝"
            if [ "${critical_status[$i]}" = "new" ]; then
                status_emoji="✨"
            fi
            details="${details}${PURPLE}  $status_emoji ${critical_changed_files[$i]} (${critical_status[$i]})\n${RESET}"
        done
        details="${details}\n"
    fi
    
    echo -e "${PURPLE}⚠️  Multiple types of changes detected:${RESET}"
    echo -e "${PURPLE}Changes include: $changes_list${RESET}"
    echo
    echo -e "$details"
    echo -e "${PURPLE}These changes will be approved together to maintain consistency.${RESET}"
    echo -e "${PURPLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    
    # Verify we have changes to approve
    if [ -z "$changes_list" ]; then
        echo "Error: No changes detected despite flags being set"
        exit 1
    fi
    
    check_human_manager_approval "Combined Changes" "$changes_list"
    if [ $? -ne 0 ]; then
        show_rejection_guidance "Combined Changes" "$changes_list"
        exit 1
    fi
fi

check_scope_changes

# All checks passed
echo -e "${PURPLE}✅ AICheck pre-commit checks passed${RESET}"
exit 0 