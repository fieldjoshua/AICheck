#!/bin/bash

# AICheck pre-commit hook
# Enforces AICheck rules and requirements

# Check if we're in an AICheck-managed repository
if [ ! -f "RULES.md" ]; then
    echo "⚠️ Warning: RULES.md not found. This may not be an AICheck-managed repository."
    exit 0
fi

# Check if common functions are available
if [ ! -f ".aicheck/scripts/common.sh" ]; then
    echo "❌ Error: AICheck common functions not found"
    echo "Please run the AICheck installer again"
    exit 1
fi

# Source common functions
source .aicheck/scripts/common.sh

# Get the current ActiveAction
if [ ! -f ".aicheck/current_action" ]; then
    echo "⚠️ Warning: No ActiveAction set"
    current_action="None"
else
    current_action=$(cat .aicheck/current_action)
    # Validate ActiveAction exists
    if [ ! -d ".aicheck/actions/$current_action" ]; then
        echo "❌ Error: ActiveAction '$current_action' does not exist"
        echo "Please set a valid ActiveAction"
        exit 1
    fi
fi

# Get list of files being committed
files=$(git diff --cached --name-only)

# Function to check if changes are substantive
is_substantive_change() {
    local file=$1
    # Get the diff content
    local diff_content=$(git diff --cached -- "$file")
    
    # Check for changes to content (not just whitespace)
    if echo "$diff_content" | grep -q "^[+-][^+-]"; then
        return 0  # Substantive change found
    fi
    return 1  # No substantive change
}

# Check for changes to critical files
critical_files=(
    "RULES.md"
    ".aicheck/docs/actions_index.md"
    ".aicheck/current_action"
)

# Function to validate actions index format
validate_actions_index() {
    local index_file=".aicheck/docs/actions_index.md"
    if [ -f "$index_file" ]; then
        # Check for required columns
        if ! grep -q "| Action | Status | Progress | Owner | Started | Last Updated | Type | Priority |" "$index_file"; then
            echo "❌ Error: Actions index is missing required columns"
            echo "Please ensure the index has all required columns"
            exit 1
        fi
        
        # Check for valid status values
        while IFS= read -r line; do
            if [[ "$line" =~ \|[[:space:]]*[^|]+[[:space:]]*\|[[:space:]]*([^|]+)[[:space:]]*\| ]]; then
                local status="${BASH_REMATCH[1]}"
                case "$status" in
                    "Not Started"|"ActiveAction"|"Completed"|"Blocked"|"On Hold")
                        continue
                        ;;
                    *)
                        echo "❌ Error: Invalid status in actions index: $status"
                        echo "Status must be one of: Not Started, ActiveAction, Completed, Blocked, On Hold"
                        exit 1
                        ;;
                esac
            fi
        done < "$index_file"
    fi
}

for file in "${critical_files[@]}"; do
    if echo "$files" | grep -q "^$file$"; then
        if is_substantive_change "$file"; then
            echo "⚠️ WARNING: Substantive changes to critical file: $file"
            echo "This requires human manager approval."
            echo "Please confirm you have approval to modify this file. (y/n)"
            read -r has_approval
            if [ "$has_approval" != "y" ]; then
                echo "❌ Commit rejected: Human manager approval required for changes to $file"
                exit 1
            fi
            
            # Validate actions index if it's being modified
            if [ "$file" == ".aicheck/docs/actions_index.md" ]; then
                validate_actions_index
            fi
        else
            echo "ℹ️ Note: Non-substantive changes to $file (whitespace only)"
        fi
    fi
done

# Check for changes to action plans
if [ "$current_action" != "None" ]; then
    action_plan=".aicheck/actions/$current_action/$current_action-PLAN.md"
    if [ -f "$action_plan" ] && echo "$files" | grep -q "^$action_plan$"; then
        if is_substantive_change "$action_plan"; then
            echo "⚠️ WARNING: Substantive changes to ActiveAction plan: $action_plan"
            echo "This requires human manager approval."
            echo "Please confirm you have approval to modify this file. (y/n)"
            read -r has_approval
            if [ "$has_approval" != "y" ]; then
                echo "❌ Commit rejected: Human manager approval required for changes to action plan"
                exit 1
            fi
        else
            echo "ℹ️ Note: Non-substantive changes to action plan (whitespace only)"
        fi
    fi
fi

# Check for changes to templates
if echo "$files" | grep -q "^.aicheck/templates/"; then
    for template in $(echo "$files" | grep "^.aicheck/templates/"); do
        if is_substantive_change "$template"; then
            echo "⚠️ WARNING: Substantive changes to template: $template"
            echo "This requires human manager approval."
            echo "Please confirm you have approval to modify this template. (y/n)"
            read -r has_approval
            if [ "$has_approval" != "y" ]; then
                echo "❌ Commit rejected: Human manager approval required for template changes"
                exit 1
            fi
        else
            echo "ℹ️ Note: Non-substantive changes to template (whitespace only)"
        fi
    done
fi

# Check for changes outside ActiveAction scope
if [ "$current_action" != "None" ]; then
    action_dir=".aicheck/actions/$current_action"
    for file in $files; do
        # Skip files that are part of the ActiveAction
        if [[ "$file" == "$action_dir"* ]]; then
            continue
        fi
        
        # Skip critical files (already checked above)
        if [[ "$file" == "RULES.md" ]] || [[ "$file" == ".aicheck/docs/actions_index.md" ]] || [[ "$file" == ".aicheck/current_action" ]]; then
            continue
        fi
        
        # Skip template files (already checked above)
        if [[ "$file" == ".aicheck/templates/"* ]]; then
            continue
        fi
        
        # Skip non-substantive changes
        if ! is_substantive_change "$file"; then
            echo "ℹ️ Note: Non-substantive changes to $file (whitespace only)"
            continue
        fi
        
        echo "⚠️ WARNING: Substantive changes detected outside ActiveAction scope: $file"
        echo "Current ActiveAction: $current_action"
        echo "Please confirm this change is within the ActiveAction scope. (y/n)"
        read -r in_scope
        if [ "$in_scope" != "y" ]; then
            echo "❌ Commit rejected: Changes must be within ActiveAction scope"
            exit 1
        fi
    done
fi

# All checks passed
echo "✅ AICheck pre-commit checks passed"
exit 0 